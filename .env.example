DATABASE_URL=postgresql://tcg:tcg@localhost:5432/tcg
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
TCGDEX_API_URL=https://api.tcgdex.net/v2/en
# Catálogo alternativo/fallback. "tcgdex" é o padrão; use "pokemontcg" para priorizar a Pokémon TCG API.
CATALOG_PROVIDER=tcgdex
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
# Opcional: amplia o limite de consulta da Pokémon TCG API. Nunca exponha no cliente.
POKEMON_TCG_API_KEY=
# Token de servidor concedido pelo suporte do MYP Cards para consultar preços em BRL.
# Nunca exponha este valor no navegador ou em repositórios.
MYP_CARDS_API_TOKEN=
SCANNER_URL=http://localhost:8001
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MARKET_INGESTION_TOKEN=
MARKET_JOB_TOKEN=
# Token OAuth de um aplicativo Mercado Livre autorizado. Nunca exponha este valor no cliente.
MELI_ACCESS_TOKEN=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
