generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  displayName  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  items        CollectionItem[]
  alerts       Alert[]
  wishlists    WishlistItem[]
  scanSessions ScanSession[]
}

model Set {
  id          String    @id
  name        String
  seriesName  String?
  logoUrl     String?
  symbolUrl   String?
  releaseDate DateTime?
  totalCards  Int?
  cards       Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String           @id
  externalId    String?          @unique
  name          String
  type          ProductType
  setId         String?
  localNumber   String?
  rarity        String?
  illustrator   String?
  imageUrl      String?
  category      String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  set           Set?             @relation(fields: [setId], references: [id])
  items         CollectionItem[]
  prices        PriceSnapshot[]
  offers        Offer[]
  wishlistItems WishlistItem[]
  scanMatches   ScanMatch[]

  @@index([name])
  @@index([setId, localNumber])
}

model CollectionItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  quantity      Int      @default(1)
  purchasePrice Decimal? @db.Decimal(12, 2)
  purchaseDate  DateTime?
  condition     CardCondition?
  language      String?
  variant       String?
  gradeCompany  String?
  gradeValue    Decimal? @db.Decimal(4, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  priority  Int      @default(2)
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PriceSnapshot {
  id          String      @id @default(cuid())
  productId   String
  source      String
  seller      String?
  currency    String      @default("BRL")
  price       Decimal     @db.Decimal(12, 2)
  shipping    Decimal?    @db.Decimal(12, 2)
  condition   CardCondition?
  language    String?
  variant     String?
  sourceUrl   String?
  observedAt  DateTime    @default(now())
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, observedAt])
  @@index([source, observedAt])
}

model Offer {
  id               String   @id @default(cuid())
  productId        String
  source           String
  seller           String?
  originalUrl      String?
  affiliateUrl     String?
  currency         String   @default("BRL")
  price            Decimal  @db.Decimal(12, 2)
  shipping         Decimal? @db.Decimal(12, 2)
  referencePrice   Decimal? @db.Decimal(12, 2)
  opportunityScore Int?
  detectedAt       DateTime @default(now())
  expiresAt        DateTime?
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, detectedAt])
  @@index([opportunityScore, detectedAt])
}

model Alert {
  id        String    @id @default(cuid())
  userId    String
  type      AlertType
  productId String?
  threshold Decimal?  @db.Decimal(12, 2)
  active    Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model ScanSession {
  id           String      @id @default(cuid())
  userId       String
  imageUrl     String?
  engine       String?
  extractedName String?
  extractedNumber String?
  status       ScanStatus  @default(PENDING)
  createdAt    DateTime    @default(now())
  completedAt  DateTime?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      ScanMatch[]
}

model ScanMatch {
  id          String      @id @default(cuid())
  scanId      String
  productId   String
  confidence  Float
  rank        Int
  accepted    Boolean     @default(false)
  scan        ScanSession @relation(fields: [scanId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([scanId, rank])
}

enum ProductType {
  CARD
  BOOSTER
  BOOSTER_BOX
  BOOSTER_BUNDLE
  ETB
  BLISTER
  COLLECTION_BOX
  PREMIUM_COLLECTION
  TIN
  DECK
  DISPLAY
  OTHER
}

enum CardCondition {
  NM
  LP
  MP
  HP
  DAMAGED
}

enum ScanStatus {
  PENDING
  PROCESSING
  NEEDS_CONFIRMATION
  CONFIRMED
  FAILED
}

enum AlertType {
  PRICE_BELOW
  DISCOUNT_ABOVE
  VALUE_INCREASE
  VALUE_DROP
  OPPORTUNITY
}
